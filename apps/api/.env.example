HOST=127.0.0.1
PORT=3000
INGEST_URL=http://localhost:8001
INDEX_PATH=data/index/index.json
# Set a local test value before using the CRM endpoint. Unset disables the endpoint.
CRM_WEBHOOK_SECRET=
# Unset uses memory. Compose sets redis://redis:6379.
REDIS_URL=
CRM_EVENT_TTL_SECONDS=604800
# Optional paid adapter. Leave unset for free extractive answers.
ANTHROPIC_API_KEY=
